{
  "datasets": [
    {
      "name": "8403e061",
      "displayName": "ventas",
      "queryLines": [
        "SELECT\r\n",
        "  f.monto_total,\r\n",
        "  f.cantidad,\r\n",
        "  f.descuento,\r\n",
        "  c.segmento,\r\n",
        "  c.pais,\r\n",
        "  c.ciudad,\r\n",
        "  p.categoria,\r\n",
        "  p.subcategoria,\r\n",
        "  p.nombre_producto,\r\n",
        "  d.fecha,\r\n",
        "  d.anio,\r\n",
        "  d.mes,\r\n",
        "  date_format(d.fecha, 'yyyy-MM') AS anio_mes\r\n",
        "FROM proyecto_final.gold.fact_ventas  f\r\n",
        "JOIN proyecto_final.gold.dim_cliente  c ON f.customer_key = c.customer_key\r\n",
        "JOIN proyecto_final.gold.dim_producto p ON f.product_key  = p.product_key\r\n",
        "JOIN proyecto_final.gold.dim_fecha    d ON f.date_key     = d.date_key\r\n",
        "\r\n"
      ],
      "columns": [
        {
          "displayName": "Total Ventas",
          "expression": "SUM(monto_total)"
        },
        {
          "displayName": "Total Unidades",
          "expression": "SUM(cantidad)"
        },
        {
          "displayName": "Descuento Promedio",
          "expression": "AVG(descuento)"
        },
        {
          "displayName": "Ticket Promedio",
          "expression": "AVG(monto_total)"
        },
        {
          "displayName": "Num Transacciones",
          "expression": "COUNT(*)"
        }
      ]
    }
  ],
